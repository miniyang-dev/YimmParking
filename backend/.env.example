# Copy to backend/.env (git-ignored) and fill in.

# Google Maps Platform key with Geocoding API and Places API (New) enabled.
# Without it, address search returns 503 "geocoder_unavailable" and food search is disabled;
# coordinate search (/api/v1/parking/nearby) keeps working.
GOOGLE_MAPS_API_KEY=

# Optional
# YIMM_DB_PATH=D:/Projects/YimmParking/backend/data/yimmparking.db
# YIMM_CORS_ORIGINS=http://localhost:5174
# YIMM_AVAILABILITY_INTERVAL_S=120
# YIMM_LOTS_INTERVAL_S=86400

# Self-imposed ceilings so the Google free tier can never be exceeded. Calls are refused (HTTP 429)
# once reached and resume the next calendar month. Defaults are 10% under the free tier
# (Geocoding 10,000; Places Nearby Search Enterprise 1,000). Raise PLACES only if you change the
# requested fields to a tier with a larger free quota.
# YIMM_GEOCODE_MONTHLY_LIMIT=9000
# YIMM_PLACES_MONTHLY_LIMIT=900

# Food quality floor. The rating is applied by Google itself (Text Search minRating, 0.5 steps) so
# low-rated places never occupy one of the at-most-20 result slots; the review count has no
# server-side filter and is applied after the response.
# YIMM_FOOD_MIN_RATING=4.0
# YIMM_FOOD_MIN_REVIEWS=100

# How long a food lookup is remembered (hours). A repeat lookup of the same lot makes no Google
# request. NOTE: Google's terms only expressly allow caching coordinates (<=30 days) and place ids,
# so this goes beyond them; 0 disables it.
# YIMM_FOOD_CACHE_TTL_HOURS=24

# Walking time (Google Routes API, Compute Route Matrix, billed per origin-destination pair).
# Routes Essentials is 10,000 free elements a month; the default limit stays 10% under it. When it is
# reached, results fall back to straight-line distance and say so.
# YIMM_ROUTES_MONTHLY_LIMIT=9000
# Every lot in range is listed, but only 8 are routed for walking time (the nearest of each
# vendor the user puts first, then the nearest of the rest). The count is fixed in the code.
# How long a walking time is remembered (days; 0 disables). Google's terms only expressly allow
# caching coordinates and place ids, so this goes beyond them, like the food cache.
# YIMM_ROUTE_CACHE_TTL_DAYS=30

# On-street (curb) parking from MOTC TDX (https://tdx.transportdata.tw): free, register a member
# and create an API key to get these two values. Without them /api/v1/curb/nearby answers 503
# "curb_unconfigured" and the web client hides the street-parking section.
# TDX_CLIENT_ID=
# TDX_CLIENT_SECRET=
